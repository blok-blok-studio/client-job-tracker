generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl removed 2026-07-27: the db.prisma.io:5432 direct endpoint resets
  // every connection (rotated creds) — DDL via `prisma db push` tunnels through
  // the Accelerate URL fine. Re-add if fresh direct creds are minted in console.
}

// --- TEAM USERS (dashboard logins) ---
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(MEMBER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  slackUserId  String? // Slack member ID (U…) for @-mentions in task alerts
  color        String? // Profile hex color for avatars and task assignee accents
  allowedPages String[]  @default([]) // Sidebar tabs a member may open; empty = all
  jobRole      String? // What they do here (see src/lib/team-roles.ts); drives the tab preset

  // --- Second-factor auth (all opt-in, default off; login is unchanged until enabled) ---
  totpSecret     String? // base32 TOTP secret, AES-256-GCM encrypted at rest ("iv:ciphertext")
  totpEnabled    Boolean  @default(false)
  pinHash        String? // bcrypt hash of a numeric quick-PIN (optional second factor)
  backupCodes    String[] @default([]) // bcrypt hashes of one-time recovery codes
  mfaUpdatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum UserRole {
  OWNER
  MEMBER
}

// --- CLIENTS ---
model Client {
  id               String     @id @default(cuid())
  name             String
  email            String?
  phone            String?
  company          String?
  type             ClientType @default(ACTIVE)
  tier             ClientTier @default(STANDARD)
  source           String?
  industry         String?
  notes            String?    @db.Text
  monthlyRetainer  Decimal?   @db.Decimal(10, 2)
  contractStart    DateTime?
  contractEnd      DateTime?
  timezone         String?
  avatarUrl        String?
  onboardToken     String?    @unique
  uploadToken      String?    @unique // Shareable link for client file uploads
  telegramChatId   String?    @unique
  stripeCustomerId String?    @unique
  companyAddress   String?    @db.Text
  companyCity      String?
  companyState     String?
  companyZip       String?
  companyCountry   String?
  taxId            String?

  // --- Lifecycle system (client/partner journey automation) ---
  role               PersonRole   @default(CLIENT)
  packageTier        PackageTier? // launch/essential/growth/scale project package — distinct from `tier` (account importance)
  projectName        String?
  projectPrice       Decimal?     @db.Decimal(10, 2)
  depositReceived    Decimal?     @db.Decimal(10, 2)
  projectBalance     Decimal?     @db.Decimal(10, 2)
  websiteUrl         String?
  contractSignedAt   DateTime?
  kickoffBookedAt    DateTime?
  kickoffHeldAt      DateTime?
  assetDeadline      DateTime?
  assetsReceivedAt   DateTime?
  launchDate         DateTime?
  finalPaymentAt     DateTime?
  supportEnd         DateTime? // computed: launchDate + support months by packageTier
  careFreeEnd        DateTime? // computed: launchDate + 3 months
  careStatus         CareStatus   @default(NONE)
  careTier           CareTier?
  referrerId         String?
  referrer           Client?      @relation("Referrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals          Client[]     @relation("Referrals")
  referralFeeOwed    Decimal?     @db.Decimal(10, 2)
  automationsPaused  Boolean      @default(false) // pause all lifecycle automations for this client
  lastPartnerTouchAt DateTime? // partners: last quarterly touch logged

  credentials     Credential[]
  tasks           Task[]
  invoices        Invoice[]
  contacts        Contact[]
  activityLogs    ActivityLog[]
  checklistItems  ChecklistItem[]
  supportTickets  SupportTicket[]
  socialLinks     SocialLink[]
  contracts       ContractSignature[]
  paymentLinks    PaymentLink[]
  contentPosts    ContentPost[]
  mediaFiles      ClientMedia[]
  automationFlows AutomationFlow[]
  timeEntries     TimeEntry[]
  reports         ClientReport[]
  deliverables    Deliverable[]
  services        ClientService[]
  scheduledSteps  ScheduledStep[]

  // Tax residency (ISO 3166-1 alpha-2, distinct from free-text companyCountry);
  // drives required tax documents
  country               String?
  additionalCountries   String[]                     @default([])
  contractorHours       ContractorHoursEntry[]
  contractorAssignments ContractorClientAssignment[]
  taxDocuments          TaxDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([tier])
  @@index([updatedAt])
  @@index([email])
  @@index([telegramChatId])
  @@index([role])
  @@index([careStatus])
}

enum ClientType {
  PROSPECT
  ACTIVE
  PAST
  ARCHIVED
}

enum ClientTier {
  VIP
  STANDARD
  TRIAL
}

enum PersonRole {
  CLIENT
  PARTNER
  CONTRACTOR
  LEAD
}

enum PackageTier {
  LAUNCH
  ESSENTIAL
  GROWTH
  SCALE
}

enum CareStatus {
  NONE
  FREE
  PAYING
  DECLINED
}

enum CareTier {
  CARE // 200/mo
  CARE_PLUS // 500/mo
  CARE_PRO // 1000/mo
}

// --- SERVICES (what each client is signed up for) ---

model ClientService {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String // service/package name — free-form, suggested from contract-templates catalog
  category  String? // PackageCategory id from contract-templates (e.g. "web-brand")
  status    ServiceStatus @default(ACTIVE)
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([category])
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// --- CONTACTS (multiple per client) ---
model Contact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
}

// --- CREDENTIALS VAULT (encrypted) ---
model Credential {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform    String
  label       String?
  username    String
  password    String
  notes       String?
  url         String?
  iv          String
  lastRotated DateTime?

  posts ContentPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- TASKS (Kanban + tracking) ---
model Task {
  id           String       @id @default(cuid())
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(BACKLOG)
  priority     Priority     @default(MEDIUM)
  category     TaskCategory @default(GENERAL)
  dueDate      DateTime?
  completedAt  DateTime?
  assignedTo   String?
  isRecurring  Boolean      @default(false)
  recurPattern String?
  tags         String[]
  sortOrder    Int          @default(0)

  // Blocked tracking: what it's waiting on, when it entered Blocked,
  // and when the stale-blocked Slack nudge was sent (null = not yet alerted)
  blockedReason  String?
  blockedAt      DateTime?
  blockedAlertAt DateTime?

  // Dependencies: this task can't start until every task in blockedBy is DONE.
  // When the last blocker completes, a BLOCKED task auto-moves back to TODO.
  blockedBy Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  checklistItems ChecklistItem[]
  activityLogs   ActivityLog[]
  timeEntries    TimeEntry[]
  deliverable    Deliverable?
  comments       TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isRecurring])
}

// --- TASK COMMENTS (team discussion thread on a card, @mentions notify) ---
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String? // User.id when known (comments are team-only)
  authorName String // display name shown on the thread
  body       String   @db.Text
  mentions   String[] @default([]) // User.ids @-mentioned in the body

  createdAt DateTime @default(now())

  @@index([taskId])
}

// --- NOTIFICATIONS (per-user in-app inbox: assignments, mentions, replies) ---
model Notification {
  id       String  @id @default(cuid())
  userId   String // recipient User.id
  type     String // task_assigned | mention | task_comment | ...
  title    String
  body     String? @db.Text
  link     String? // in-app URL, e.g. /kanban?task=<id>
  taskId   String?
  clientId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// --- MONTHLY CLIENT REPORTS (AI-generated from uploaded analytics) ---
model ClientReport {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month      String // "2026-07"
  rawData    String       @db.Text
  notes      String?      @db.Text
  report     Json? // { metrics, highlights, summary, trajectory, recommendations }
  preparedBy String?
  status     ReportStatus @default(DRAFT)
  sentAt     DateTime?
  sentTo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month])
  @@index([month])
}

enum ReportStatus {
  DRAFT
  SENT
}

// --- NEWSLETTER (subscriber list + sent campaigns) ---
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String    @default("manual") // manual, website, client-portal, import
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([subscribedAt])
}

model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String   @db.Text
  sentBy     String
  recipients Int
  sentAt     DateTime @default(now())
}

// --- TIME TRACKING (billable hours per task/client) ---
model TimeEntry {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userName String
  minutes  Int
  note     String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([clientId])
  @@index([createdAt])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskCategory {
  GENERAL
  CONTENT_CREATION
  SOCIAL_MEDIA
  CLIENT_COMMS
  REPORTING
  STRATEGY
  INVOICING
  ONBOARDING
  OFFBOARDING
  DEVELOPMENT
  DESIGN
}

// --- CHECKLIST ITEMS (per task or per client) ---
model ChecklistItem {
  id        String  @id @default(cuid())
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  checked   Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([taskId])
}

// --- INVOICES ---
model Invoice {
  id       String        @id @default(cuid())
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("USD")
  status   InvoiceStatus @default(DRAFT)
  region   String        @default("US")
  country  String        @default("US")
  dueDate  DateTime?
  paidAt   DateTime?
  notes    String?

  stripeInvoiceId  String? @unique
  stripeInvoiceUrl String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// --- ACTIVITY LOG ---
model ActivityLog {
  id        String  @id @default(cuid())
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor     String
  action    String
  details   String? @db.Text
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([action])
  @@index([createdAt])
}

// --- SUPPORT TICKETS (Telegram) ---
model SupportTicket {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  telegramChatId String
  subject        String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender   String // "client" | "chase" | "bot"
  text     String        @db.Text

  createdAt DateTime @default(now())
}

// --- SOCIAL LINKS ---
model SocialLink {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform String
  url      String
  handle   String?

  createdAt DateTime @default(now())
}

// --- CONTRACT SIGNATURES ---
model ContractSignature {
  id           String @id @default(cuid())
  clientId     String
  client       Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token        String @unique
  contractBody String @db.Text

  // Provider (Chase) counter-signature
  providerSignedName    String?
  providerSignatureData String?   @db.Text // Base64 PNG of drawn signature
  providerSignedAt      DateTime?
  providerIpAddress     String?
  providerUserAgent     String?   @db.Text

  // Client signature
  signedName    String?
  signatureData String?   @db.Text // Base64 PNG of drawn signature
  signedAt      DateTime?
  ipAddress     String?
  userAgent     String?   @db.Text

  // Document integrity (SHA-256)
  documentHash       String?
  signedDocumentHash String?

  status    ContractStatus @default(PENDING)
  expiresAt DateTime?

  // Structured package selection for auto task generation
  selectedPackages Json?

  paymentLinks PaymentLink[]
  auditLogs    ContractAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- CONTRACT AUDIT LOG ---
model ContractAuditLog {
  id         String            @id @default(cuid())
  contractId String
  contract   ContractSignature @relation(fields: [contractId], references: [id], onDelete: Cascade)
  event      String // "created", "provider_signed", "viewed", "client_signed"
  actor      String // "provider", "client", "system"
  ipAddress  String?
  userAgent  String?           @db.Text
  metadata   String?           @db.Text

  createdAt DateTime @default(now())

  @@index([contractId])
}

enum ContractStatus {
  DRAFT
  PENDING
  SIGNED
  EXPIRED
}

// --- PAYMENT LINKS (Stripe) ---
model PaymentLink {
  id                   String             @id @default(cuid())
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stripePaymentLink    String             @unique
  stripeUrl            String
  amount               Int // cents
  currency             String             @default("usd")
  description          String
  recurring            Boolean            @default(false)
  interval             String? // "month" | "year"
  country              String             @default("US")
  status               PaymentStatus      @default(PENDING)
  stripePriceId        String?
  stripeProductId      String?
  stripeSessionId      String?
  stripeSubscriptionId String?
  paidAt               DateTime?
  contractId           String?
  contract             ContractSignature? @relation(fields: [contractId], references: [id])
  milestone            String? // "deposit" | "completion" | null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  ACTIVE
  EXPIRED
  CANCELLED
}

// --- CONTENT POSTS (Social Media Calendar) ---
model ContentPost {
  id           String            @id @default(cuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   Credential?       @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  platform     SocialPlatform
  status       ContentPostStatus @default(DRAFT)

  title     String?
  body      String?  @db.Text
  hashtags  String[]
  mediaUrls String[]

  // Location tagging
  location    String?
  locationLat Float?
  locationLng Float?

  // People & Collaboration
  taggedUsers   String[] // @handles of tagged people
  collaborators String[] // Instagram collab invites, LinkedIn co-authors

  // Media enhancements
  altText       String? @db.Text // Accessibility alt text for media
  coverImageUrl String? // Reel/TikTok/YouTube cover frame
  thumbnailUrl  String? // YouTube custom thumbnail

  // Auto-first comment (Instagram strategy)
  firstComment String? @db.Text

  // Platform-specific settings (JSON blob)
  // Twitter: { threadPosts, pollOptions, pollDuration, quoteTweetUrl }
  // YouTube: { category, playlist, tags, privacyStatus, madeForKids }
  // TikTok:  { allowComments, allowDuet, allowStitch, privacyLevel }
  // LinkedIn: { articleMode, visibility }
  // Facebook: { feeling, album }
  // Instagram: { shareToFeed, shareToStory }
  platformSettings Json?

  // Content management
  visibility     String? @default("PUBLIC") // PUBLIC, PRIVATE, UNLISTED
  enableComments Boolean @default(true)

  scheduledAt  DateTime?
  publishedAt  DateTime?
  publishError String?   @db.Text
  externalId   String?
  externalUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
  @@index([platform])
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  TWITTER
  THREADS
  LINKEDIN
  YOUTUBE
  FACEBOOK
}

enum ContentPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// --- CLIENT MEDIA LIBRARY ---
// Files uploaded by clients via their portal link, or by you manually
model ClientMedia {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  url      String // Vercel Blob URL
  filename String // Original filename
  fileType MediaFileType // IMAGE, VIDEO, AUDIO
  fileSize Int // Bytes
  mimeType String // e.g. image/jpeg, video/mp4, audio/mpeg
  duration Float? // Seconds (for video/audio)
  width    Int? // Pixels (for image/video)
  height   Int? // Pixels (for image/video)

  thumbnailUrl String? // JPEG thumbnail for videos (generated server-side)
  playbackUrl  String? // Web-safe H.264 MP4 transcode for in-browser playback (HEVC .mov etc.)

  label      String? // Optional user-given label
  folder     String? // Event / collection this file belongs to (for grouping uploads)
  notes      String? // Notes about this file
  favorite   Boolean @default(false) // Heart-marked: used / liked when sifting content
  uploadedBy String  @default("client") // "client" or "manager"

  usedInPosts String[] // Post IDs this media has been used in

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([fileType])
  @@index([folder])
  @@index([createdAt])
}

enum MediaFileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// --- DELIVERABLES (finalized work sent to clients for review/approval) ---
// Team uploads finished work + finalized content, client gets a public review
// link (like contracts) and either approves or requests a revision with notes.
model Deliverable {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token    String @unique // public review link token

  title   String
  message String? @db.Text // note shown to the client on the review page
  content String? @db.Text // finalized content body (copy, captions, etc.)

  status        DeliverableStatus @default(PENDING_REVIEW)
  revisionNotes String?           @db.Text // latest "what's needed" from the client
  respondedBy   String? // name the client typed when responding
  respondedAt   DateTime?
  revisionCount Int               @default(0)

  createdBy String? // team member who sent it
  files     DeliverableFile[]
  comments  DeliverableComment[]

  // Linked kanban card that follows the review lifecycle automatically:
  // created in IN_REVIEW → DONE on approval / TODO as a revision task on changes
  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model DeliverableFile {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  url       String // Vercel Blob URL
  filename  String
  fileSize  Int
  mimeType  String
  folder    String? // relative folder path as uploaded (e.g. "Carousel 1"), null = root
  sortOrder Int     @default(0) // explicit display order — folder batches keep their sequence

  // Per-item client review — null until the client marks this item
  decision  FileDecision?
  decidedAt DateTime?

  comments DeliverableComment[]

  createdAt DateTime @default(now())

  @@index([deliverableId])
}

// Back-and-forth on a deliverable: client feedback on an item (or the whole
// deliverable when fileId is null) and team replies, shown on both the public
// review page and the client's Deliverables tab.
model DeliverableComment {
  id            String           @id @default(cuid())
  deliverableId String
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  fileId        String? // null = general comment on the whole deliverable
  file          DeliverableFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  author   String // display name (client-typed or team member)
  fromTeam Boolean @default(false)
  body     String  @db.Text

  createdAt DateTime @default(now())

  @@index([deliverableId])
  @@index([fileId])
}

enum FileDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum DeliverableStatus {
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
}

// --- AUDIO LIBRARY ---
// Royalty-free tracks and uploaded audio for mixing into videos
model AudioTrack {
  id         String   @id @default(cuid())
  title      String
  artist     String?
  genre      String?
  mood       String?
  duration   Float // Seconds
  url        String // File URL
  source     String // "upload", "pixabay", "freesound"
  sourceId   String? // External ID from source
  sourceUrl  String? // Link to original
  bpm        Int?
  isLicensed Boolean  @default(true)
  tags       String[]

  createdAt DateTime @default(now())

  @@index([genre])
  @@index([mood])
  @@index([source])
}

// --- DM AUTOMATION (ManyChat Replacement) ---

model AutomationFlow {
  id            String  @id @default(cuid())
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  description   String? @db.Text
  platform      String // INSTAGRAM, FACEBOOK, THREADS
  trigger       String // KEYWORD, COMMENT, STORY_REPLY, NEW_FOLLOWER, MANUAL
  triggerConfig Json? // { keywords: [], matchType: "contains"|"exact"|"starts_with" }
  nodes         Json    @default("[]") // Reactflow nodes
  edges         Json    @default("[]") // Reactflow edges
  active        Boolean @default(false)

  executions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([platform])
  @@index([active])
}

model AutomationExecution {
  id          String         @id @default(cuid())
  flowId      String
  flow        AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contactId   String? // Platform user ID (IG sender ID)
  contactName String? // Display name
  status      String         @default("RUNNING") // RUNNING, PAUSED, COMPLETED, FAILED
  currentNode String? // Current node ID waiting for input
  context     Json? // { variables: {}, conversationHistory: [] }
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  error       String?        @db.Text

  messages AutomationMessage[]

  @@index([flowId])
  @@index([contactId])
  @@index([status])
}

model AutomationMessage {
  id          String              @id @default(cuid())
  executionId String
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  direction   String // INBOUND, OUTBOUND
  text        String?             @db.Text
  mediaUrl    String?
  nodeId      String? // Which flow node produced this
  metadata    Json? // Quick replies sent, buttons clicked, etc.
  createdAt   DateTime            @default(now())

  @@index([executionId])
}

// --- CONTRACTORS (subcontractors who invoice Blok Blok) ---
model Contractor {
  id          String  @id @default(cuid())
  name        String
  email       String?
  company     String?
  phone       String?
  notes       String? @db.Text
  isActive    Boolean @default(true)
  uploadToken String  @unique // public invoice-upload link

  // --- Lifecycle system (contractor onboarding/review cadence; tasks only, never emails) ---
  agreementSignedAt DateTime?
  trialScore        Int?
  weeklyReviewDay   Int? // 0=Sunday … 6=Saturday
  automationsPaused Boolean   @default(false)

  // Tax residency (ISO 3166-1 alpha-2); drives required tax documents
  country             String?
  additionalCountries String[] @default([])

  // --- Profile (the human side; all optional, none of it legally load-bearing) ---
  avatarUrl       String? // selfie / profile photo (public Vercel Blob, unguessable path)
  avatarUpdatedAt DateTime?
  role            String? // free-form: "Video Editor", "Frontend Dev"
  skills          String[] @default([])
  accentColor     String? // hex, drives their profile chrome
  emoji           String? // one emoji they pick — shows next to their name
  bio             String?  @db.Text
  funFact         String?
  location        String?
  timezone        String? // IANA, remembered from their hours logs
  startedAt       DateTime? // first day working with us (tenure badge)
  links           Json? // { portfolio, github, instagram, ... }

  invoices          ContractorInvoice[]
  scheduledSteps    ScheduledStep[]
  hoursEntries      ContractorHoursEntry[]
  clientAssignments ContractorClientAssignment[]
  taxDocuments      TaxDocument[]
  contracts         ContractorContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// --- CONTRACTOR CONTRACTS ---
// Agreements we send TO contractors (IC agreement, NDA, SOW). Deliberately a
// separate model from ContractSignature (client contracts): different party,
// different lifecycle, no payment links — and keeping them apart means client
// contract code never has to reason about a nullable client.
model ContractorContract {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  token        String @unique // public signing link
  kind         String @default("IC_AGREEMENT") // IC_AGREEMENT | NDA | SOW | OTHER
  title        String @default("Independent Contractor Agreement")
  contractBody String @db.Text

  // Provider (Blok Blok) counter-signature — captured at generation time
  providerSignedName    String?
  providerSignatureData String?   @db.Text // Base64 PNG of drawn signature
  providerSignedAt      DateTime?
  providerIpAddress     String?
  providerUserAgent     String?   @db.Text

  // Contractor signature
  signedName    String?
  signatureData String?   @db.Text
  signedAt      DateTime?
  ipAddress     String?
  userAgent     String?   @db.Text

  // Document integrity (SHA-256)
  documentHash       String?
  signedDocumentHash String?

  status    ContractStatus @default(DRAFT)
  expiresAt DateTime?

  // Governing-law / jurisdiction snapshot the body was drafted under
  country String?

  auditLogs ContractorContractAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
  @@index([status])
}

// Immutable audit trail for contractor agreements (created / sent / viewed / signed)
model ContractorContractAudit {
  id         String             @id @default(cuid())
  contractId String
  contract   ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  event     String // "created" | "provider_signed" | "sent" | "viewed" | "contractor_signed" | "voided"
  actor     String // "provider" | "contractor" | "system"
  ipAddress String?
  userAgent String? @db.Text
  metadata  String? @db.Text

  createdAt DateTime @default(now())

  @@index([contractId])
}

model ContractorInvoice {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  invoiceNumber String?
  description   String?   @db.Text
  amount        Decimal?  @db.Decimal(10, 2)
  currency      String    @default("USD")
  invoiceDate   DateTime?
  dueDate       DateTime?

  fileUrl     String
  filename    String
  contentType String?
  size        Int?

  // File is AES-256-GCM encrypted at rest in Blob storage; iv needed to decrypt.
  // Plaintext blob is deleted right after registration.
  encrypted    Boolean @default(false)
  encryptionIv String?

  // AI scan of the uploaded file (amount verification for legal/bookkeeping)
  scanStatus           ContractorInvoiceScanStatus @default(PENDING)
  scannedAmount        Decimal?                    @db.Decimal(10, 2)
  scannedCurrency      String?
  scannedInvoiceNumber String?
  scannedInvoiceDate   DateTime?
  scannedDueDate       DateTime?
  scanSummary          String?                     @db.Text
  scannedAt            DateTime?

  status ContractorInvoiceStatus @default(PENDING)

  // Submission audit (legal record of who sent what, when, from where)
  submittedAt     DateTime @default(now())
  submitIp        String?
  submitUserAgent String?  @db.Text

  paidAt     DateTime?
  paidBy     String? // team member who marked it paid
  paymentRef String? // how it was paid (bank ref, Wise, Zelle, ...)

  notes  ContractorInvoiceNote[]
  audits ContractorInvoiceAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
  @@index([status])
  @@index([submittedAt])
}

enum ContractorInvoiceStatus {
  PENDING
  PAID
  DISPUTED
}

enum ContractorInvoiceScanStatus {
  PENDING // scan not run yet
  MATCHED // scanned amount agrees with what the contractor entered
  AUTO_FILLED // contractor left amount blank; filled from the scan
  MISMATCH // scanned amount differs from what the contractor entered
  NO_DATA // file scanned but no amount found
  SKIPPED // file type we can't scan (docx/xlsx)
  FAILED // scan errored
}

model ContractorInvoiceNote {
  id        String            @id @default(cuid())
  invoiceId String
  invoice   ContractorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  author    String // team member name or "contractor"
  body      String            @db.Text

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// Immutable event trail (who did what, when, from where) for legal records
model ContractorInvoiceAudit {
  id        String            @id @default(cuid())
  invoiceId String
  invoice   ContractorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  event     String // "uploaded", "marked_paid", "marked_unpaid", "disputed", "note_added", "details_edited"
  actor     String // team member name or "contractor"
  ipAddress String?
  userAgent String?           @db.Text
  metadata  String?           @db.Text

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// --- CONTRACTOR HOURS LOG (self-reported work sessions; legal records, append-only) ---

// Access control only (which clients a contractor may log hours against) — not a legal
// record; the hours entry snapshots clientName so deleting an assignment/client never
// destroys evidence.
model ContractorClientAssignment {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    String // team member name
  createdAt    DateTime   @default(now())

  @@unique([contractorId, clientId])
  @@index([clientId])
}

// Append-only: no update or delete path exists for submitted entries. Mistakes are
// fixed by a correction entry pointing at the original via correctsId.
model ContractorHoursEntry {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // Client tag: SetNull + name snapshot so the record survives client deletion.
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String? // snapshot at submit time; null client = general/internal work

  // Time, dual representation: UTC instants for math + the literal values the
  // contractor typed in their own timezone (workDate is a plain string on purpose —
  // avoids the repo's UTC-midnight date rendering trap).
  startAt          DateTime
  endAt            DateTime
  durationMinutes  Int
  workDate         String // "YYYY-MM-DD" as typed
  startLocal       String // "HH:mm" as typed
  endLocal         String // "HH:mm" as typed
  timezone         String // IANA zone from the contractor's browser
  utcOffsetMinutes Int

  description String @db.Text

  // Legal attestation captured at submit time (exact wording stored on the row)
  attestationText String
  attestedAt      DateTime

  status ContractorHoursStatus @default(LOGGED)

  reviewedAt DateTime?
  reviewedBy String? // team member who marked reviewed/disputed

  // Correction chain: a correction is a NEW attested entry; the original is never
  // mutated. @unique = an entry can be corrected at most once.
  correctsId  String?               @unique
  corrects    ContractorHoursEntry? @relation("HoursCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy ContractorHoursEntry? @relation("HoursCorrection")

  // Submission audit (legal record of who sent what, when, from where)
  submittedAt     DateTime @default(now())
  submitIp        String?
  submitUserAgent String?  @db.Text

  notes  ContractorHoursNote[]
  audits ContractorHoursAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId, startAt])
  @@index([clientId])
  @@index([status])
  @@index([submittedAt])
}

enum ContractorHoursStatus {
  LOGGED
  REVIEWED
  DISPUTED
}

model ContractorHoursNote {
  id      String               @id @default(cuid())
  entryId String
  entry   ContractorHoursEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author  String // team member name or "contractor"
  body    String               @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
}

// Immutable event trail (who did what, when, from where) for legal records
model ContractorHoursAudit {
  id        String               @id @default(cuid())
  entryId   String
  entry     ContractorHoursEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  event     String // "logged", "corrected_by", "marked_reviewed", "marked_disputed", "marked_logged", "note_added", "client_reassigned"
  actor     String // team member name or "contractor"
  ipAddress String?
  userAgent String?              @db.Text
  metadata  String?              @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
}

// --- LIFECYCLE SYSTEM (sequences, templates, scheduled steps, settings) ---

// Editable email/task templates. Shipped copy lives in src/lib/lifecycle/templates-source.ts
// ("reset to original" restores it); the DB row is what renders at send time.
model EmailTemplate {
  id        String       @id @default(cuid())
  key       String       @unique // "A1", "B2", "snippet_phase_signoff", …
  name      String
  subject   String
  body      String       @db.Text
  kind      TemplateKind
  updatedBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  versions EmailTemplateVersion[]
}

enum TemplateKind {
  SEQUENCE_EMAIL // auto-sent by a sequence step
  SEQUENCE_DRAFT // pre-filled draft/task, human sends (C1, E1, G1)
  SNIPPET // manual-send library (phase sign-off, kickoff recap, partner outreach)
}

// Every save snapshots the previous copy here for one-click revert.
model EmailTemplateVersion {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subject    String
  body       String        @db.Text
  editedBy   String
  createdAt  DateTime      @default(now())

  @@index([templateId, createdAt])
}

// One row per sequence (A–I): enable toggle (owner only) + editable step timings.
model SequenceConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "A" … "I"
  name      String
  enabled   Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps SequenceStepConfig[]
}

model SequenceStepConfig {
  id            String         @id @default(cuid())
  sequenceId    String
  sequence      SequenceConfig @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  key           String         @unique // "A1", "B_minus7", "I_day30", …
  label         String
  kind          StepKind
  templateKey   String? // EmailTemplate.key rendered for this step
  offsetMinutes Int // relative to the sequence anchor date (negative = before)
  sortOrder     Int            @default(0)
  updatedBy     String?
  updatedAt     DateTime       @updatedAt

  @@index([sequenceId])
}

enum StepKind {
  EMAIL // auto-send (guarded by master switch + dry run)
  DRAFT // pre-filled draft, one-click human send after editing
  TASK // internal task for the team, never emails anyone
}

// Materialized per-record step instances — powers the per-client timeline,
// cancellation, skip, and rescheduling when timings change.
model ScheduledStep {
  id              String      @id @default(cuid())
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractorId    String?
  contractor      Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  sequenceKey     String // "A" … "I"
  stepKey         String // SequenceStepConfig.key ("A1", "B_minus7", …)
  occurrence      Int         @default(0) // recurring steps (weekly/quarterly) increment this
  kind            StepKind
  status          StepStatus  @default(PENDING)
  anchorAt        DateTime // trigger anchor — offsets recompute from this when timings change
  scheduledFor    DateTime
  processedAt     DateTime?
  cancelReason    String? // why this step was cancelled/skipped (shown in timeline)
  dryRun          Boolean     @default(false) // processed in dry-run mode: rendered + recorded, nothing emailed
  renderedSubject String?
  renderedBody    String?     @db.Text
  taskId          String? // kanban task created by TASK/DRAFT steps
  meta            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, contractorId, stepKey, occurrence])
  @@index([status, scheduledFor])
  @@index([clientId])
  @@index([contractorId])
  @@index([sequenceKey])
}

enum StepStatus {
  PENDING
  SENT // email delivered (or dry-run recorded)
  DONE // task/draft created
  CANCELLED // cancel condition met before it fired
  SKIPPED // manually skipped by the team
  FAILED
}

// Small key-value store: booking link, tier constants overrides, master switches.
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// --- TAX COMPLIANCE (multi-country deadline catalog + per-person form tracking) ---
// Informational tracking only — not tax advice; nothing here generates or files forms.

// Blok Blok's own tax identities (US LLC in Texas, DE freelancer, ...)
model TaxProfile {
  id         String  @id @default(cuid())
  country    String // ISO 3166-1 alpha-2
  label      String // "BlokBlok LLC (Texas)"
  entityType String // "llc", "freelancer", ...
  flags      Json // { state: "TX" } / { kleinunternehmer: true, steuerberater: true }
  active     Boolean @default(true)

  obligations  TaxObligation[]
  taxDocuments TaxDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Editable deadline catalog. Shipped rows live in src/lib/tax/obligations-source.ts
// ("reset to source" restores them); the DB row is what the reminder engine reads.
model TaxObligation {
  id        String        @id @default(cuid())
  key       String        @unique // stable id from obligations-source.ts, e.g. "us-1099-nec"
  country   String // ISO 3166-1 alpha-2
  appliesTo TaxAppliesTo
  profileId String?
  profile   TaxProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)

  name        String
  formName    String?
  description String       @db.Text
  frequency   TaxFrequency
  // Due-date rules: ANNUAL/ONE_TIME = [{month, day}], QUARTERLY = 4 of those,
  // MONTHLY = [{dayOfMonth}], WATCH = [] (threshold checks, no fixed date).
  dueRules    Json
  // When submission opens (e.g. IRS e-file opening late January); reminder stage 0.
  earliestOpen Json?

  sourceUrls        String[] @default([])
  verifyWithAdvisor Boolean  @default(false)
  enabled           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([enabled])
}

enum TaxAppliesTo {
  SELF // Blok Blok's own filing
  CONTRACTOR // paperwork for people we pay
  CLIENT // paperwork for people who pay us
}

enum TaxFrequency {
  ANNUAL
  QUARTERLY
  MONTHLY
  ONE_TIME
  WATCH // threshold/status watch with no fixed due date
}

// Per-person form tracking, both directions (they send us / we send them).
model TaxDocument {
  id           String      @id @default(cuid())
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      TaxProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  direction TaxDocDirection
  type      String // "W9", "W8BEN", "PAYMENT_SUMMARY", "RECHNUNG_INFO", ...
  status    TaxDocStatus    @default(REQUESTED)

  // Optional uploaded file — AES-256-GCM encrypted at rest like contractor invoices
  fileUrl      String?
  filename     String?
  contentType  String?
  size         Int?
  encrypted    Boolean @default(false)
  encryptionIv String?

  validUntil DateTime? // e.g. W-8BEN = 3 years from signing
  requestedAt DateTime @default(now())
  receivedAt  DateTime?

  // Self-attestation (for SSN/TIN forms we deliberately DON'T store — the
  // contractor confirms they hold the form and delivered it to the accountant)
  attestedAt      DateTime?
  attestationText String?

  // Stamped when uploaded/attested through the public contractor portal
  submitIp        String?
  submitUserAgent String? @db.Text

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
  @@index([clientId])
  @@index([status])
}

enum TaxDocDirection {
  INBOUND // they provide it to us
  OUTBOUND // we provide it to them
}

enum TaxDocStatus {
  REQUESTED
  RECEIVED
  SENT
  EXPIRED
  NA
  ATTESTED // contractor confirmed they hold the form (SSN/TIN) — no copy stored here
}
